# Monitoramento em desenvolvimento (ver monitoring/docker-compose.dev.yml).
GSB_SECRETS_DIR=./.secrets-dev
GRAFANA_ADMIN_USER=admin
GRAFANA_ROOT_URL=http://localhost:3000/
GRAFANA_COOKIE_SECURE=false
GRAFANA_PORT=3000
PG_EXPORTER_DATABASE=geosegbar_dev
PG_EXPORTER_HOST=geosegbar-postgres-dev
# Em dev não existe o papel `monitoring`: use o usuário do .env (DB_USERNAME) e
# ponha a senha dele em .secrets-dev/pg_monitoring_password.
PG_EXPORTER_USER=postgres
REDIS_EXPORTER_HOST=geosegbar-redis-dev
PG_STAT_STATEMENTS_FLAG=no-collector.stat_statements
BLACKBOX_TARGETS=https://api.geosegbar.com.br/nginx-health
PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=2GB
# O node-exporter não sobe em dev (profile host-metrics), mas a variável precisa
# existir para o compose interpolar o arquivo.
NODE_EXPORTER_LISTEN=127.0.0.1:9100
HOST_LOG_DIR=/var/log

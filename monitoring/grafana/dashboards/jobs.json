  ],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Tarefas agendadas (@Scheduled)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "table",
      "title": "Tarefas agendadas",
      "description": "Cada linha é um método @Scheduled; confira quantas vezes rodou, quantas falhou e quanto tempo levou na janela.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (code_namespace, code_function) (increase(tasks_scheduled_execution_seconds_count{job=\"geosegbar-api\"}[$__range]))",
          "instant": true,
          "range": false,
          "refId": "A",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(sum by (code_namespace, code_function) (increase(tasks_scheduled_execution_seconds_count{job=\"geosegbar-api\", outcome=\"ERROR\"}[$__range]))) or (sum by (code_namespace, code_function) (increase(tasks_scheduled_execution_seconds_count{job=\"geosegbar-api\"}[$__range])) * 0)",
          "instant": true,
          "range": false,
          "refId": "B",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (code_namespace, code_function) (increase(tasks_scheduled_execution_seconds_sum{job=\"geosegbar-api\"}[$__range])) / sum by (code_namespace, code_function) (increase(tasks_scheduled_execution_seconds_count{job=\"geosegbar-api\"}[$__range]))",
          "instant": true,
          "range": false,
          "refId": "C",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (code_namespace, code_function) (max_over_time(tasks_scheduled_execution_seconds_max{job=\"geosegbar-api\"}[$__range]))",
          "instant": true,
          "range": false,
          "refId": "D",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false,
            "inspect": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "nenhuma tarefa agendada executou na janela"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Execuções"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Erros"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duração média"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duração máxima"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 300
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Erros"
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "code_namespace": 0,
              "code_function": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5
            },
            "renameByName": {
              "code_namespace": "Classe",
              "code_function": "Método",
              "Value #A": "Execuções",
              "Value #B": "Erros",
              "Value #C": "Duração média",
              "Value #D": "Duração máxima"
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Falhas dos jobs",
      "description": "Falhas por job em cada intervalo, contadas na auditoria (os jobs capturam a própria exceção, então a métrica do @Scheduled não as vê) e, à parte, exceções que escaparam do método; barras repetidas no mesmo job indicam job quebrado.",

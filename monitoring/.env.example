# Configuração da stack de monitoramento (sem segredos).
#
# Em produção este arquivo vive em /etc/geosegbar/monitoring/monitoring.env
# (root, 0600) e os segredos em /etc/geosegbar/monitoring/secrets/ (pasta 0700,
# um arquivo por segredo). O deploy do monitoramento cria os dois na primeira
# execução e para, pedindo que você preencha. Passo a passo em
# docs/MONITORAMENTO.md, "Primeira instalação".

# Pasta dos segredos (um arquivo por segredo, sem quebra de linha no fim):
#   grafana_admin_password      senha do admin do Grafana (gerada pelo deploy)
#   pg_monitoring_password      senha do papel `monitoring` no Postgres (gerada)
#   telegram_bot_token          token do bot (BotFather)
#   telegram_chat_id            id numérico do chat ou grupo
#   healthchecks_watchdog_url   URL de ping do check "Watchdog" no healthchecks.io
GSB_SECRETS_DIR=/etc/geosegbar/monitoring/secrets

# Grafana. O usuário admin não se chama "admin" de propósito.
GRAFANA_ADMIN_USER=gsb-admin
# URL pela qual o time abre o Grafana. Com Tailscale:
#   https://<nome-do-servidor>.<sua-tailnet>.ts.net:8443/
GRAFANA_ROOT_URL=http://localhost:3000/
# true exige HTTPS (Tailscale). Use false só se acessar por túnel SSH no Safari.
GRAFANA_COOKIE_SECURE=true
GRAFANA_PORT=3000

# Banco que o postgres-exporter observa (o DB_NAME do .env.prod).
PG_EXPORTER_DATABASE=geosegbar_prod
PG_EXPORTER_HOST=postgres-prod
REDIS_EXPORTER_HOST=redis-prod
# Fase 4: troque para collector.stat_statements depois de ligar a extensão
# (bash/scripts/monitoring/enable_pg_stat_statements.sh faz isso).
PG_STAT_STATEMENTS_FLAG=no-collector.stat_statements

# URLs públicas sondadas pelo blackbox (separadas por vírgula).
BLACKBOX_TARGETS=https://api.geosegbar.com.br/nginx-health

# Retenção do Prometheus. O teto de tamanho vence o de tempo.
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=8GB

# Preenchido pelo deploy com o IP da ponte docker0 (ex. 172.17.0.1:9100).
# O node_exporter escuta só ali, nunca em 0.0.0.0.
NODE_EXPORTER_LISTEN=

# Pasta de logs do host lida pelo Alloy (SSH, kernel, Apache/ModSecurity).
HOST_LOG_DIR=/var/log

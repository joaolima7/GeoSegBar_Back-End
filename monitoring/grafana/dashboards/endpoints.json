          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (method, uri, le) (rate(http_server_requests_seconds_bucket{job=\"geosegbar-api\", uri=~\"$uri\", method=~\"$method\"}[$__range])))",
          "instant": true,
          "range": false,
          "refId": "C",
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"geosegbar-api\", uri=~\"$uri\", method=~\"$method\", status=~\"5..\"}[$__range])) / sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"geosegbar-api\", uri=~\"$uri\", method=~\"$method\"}[$__range]))) or (sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"geosegbar-api\", uri=~\"$uri\", method=~\"$method\"}[$__range])) * 0)",

# Resolver do DNS embutido do Docker (127.0.0.11). Permite resolver o upstream
# em TEMPO DE REQUEST, e não no startup. Sem isso, se o container da API ainda
# não estiver resolvível quando o nginx sobe (ex.: durante o deploy, logo após
# recriar o container da API), o nginx falha com "[emerg] host not found in
# upstream" e MORRE — derrubando o proxy e, com ele, toda a API publicada.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    server_name _;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;

    client_max_body_size 512m;

    proxy_request_buffering on;

    client_body_timeout 1800s;

    client_body_buffer_size 1m;

    client_body_temp_path /tmp/nginx-uploads 1 2;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Accept-Encoding "";

    proxy_connect_timeout 10s;

    proxy_send_timeout 900s;

    proxy_read_timeout 900s;

    proxy_buffering on;
    proxy_buffer_size 8k;
    proxy_buffers 16 32k;
    proxy_busy_buffers_size 64k;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_buffers 32 16k;
    gzip_http_version 1.1;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/json
        application/javascript
        application/xml
        application/xml+rss;

    keepalive_timeout 65;
    keepalive_requests 1000;

    location = /nginx-health {
        access_log off;
        return 200 'OK';
        add_header Content-Type text/plain;
    }

    # O actuator NÃO é público.
    #
    # /actuator/health e /actuator/prometheus são liberados no Spring para que o
    # HEALTHCHECK do Docker e o Prometheus funcionem — ambos alcançam o container
    # direto pela rede interna, sem passar por aqui. Da internet, tudo sob
    # /actuator/ é negado: com management.endpoints.web.exposure.include=*, expor
    # isso publicaria /actuator/env e /actuator/configprops, que carregam segredos.
    location /actuator/ {
        access_log off;
        deny all;
        return 404;
    }

    # Download da pasta compartilhada em ZIP.
    #
    # É a única rota de download que ainda transmite bytes pelo proxy: o ZIP é
    # montado combinando vários arquivos, então não há como redirecionar para o
    # S3 como as rotas de arquivo único fazem.
    #
    # proxy_buffering off é REQUISITO, não ajuste fino. Com o buffering ligado
    # o nginx lê do upstream o mais rápido que consegue e acumula a resposta —
    # primeiro na memória, depois em arquivo temporário em disco, até
    # proxy_max_temp_file_size (1 GB por padrão). Numa pasta com vários GB isso
    # significa escrever GB em disco a cada download e só então começar a
    # entregar, anulando exatamente o streaming que o ZipService faz questão de
    # manter. Desligado, cada bloco lido do upstream vai direto para o cliente.
    #
    # gzip off: o ZIP já está comprimido. Comprimir de novo gasta CPU e não
    # reduz nada.
    #
    # O timeout é maior que o global porque aqui o tempo é o da transferência
    # inteira, não o de uma resposta.
    location ~ ^/share/download/ {
        include /etc/nginx/upstream_active.conf;

        proxy_buffering off;
        gzip off;

        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;

        proxy_pass http://$upstream_server;
    }

    location / {
        # O upstream ativo vem de um arquivo separado, reescrito pelo deploy e
        # aplicado com `nginx -s reload`. O reload é gracioso: os workers antigos
        # terminam as requisições em andamento e os novos já usam o upstream novo,
        # então a troca de versão não derruba nem uma conexão.
        #
        # O arquivo fica FORA de /etc/nginx/conf.d/ de propósito. O nginx.conf
        # auto-inclui todo *.conf daquele diretório no contexto `http`, e a
        # diretiva `set` só é válida dentro de server/location — montado lá, o
        # nginx recusa a subir com "set directive is not allowed here".
        #
        # A variável (em vez de um bloco `upstream` estático) força a resolução
        # dinâmica pelo resolver acima. Se a API ficar momentaneamente indisponível,
        # o nginx devolve 502 pontual e se recupera sozinho — não morre.
        include /etc/nginx/upstream_active.conf;
        proxy_pass http://$upstream_server;
    }
}

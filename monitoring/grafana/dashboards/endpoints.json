      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"geosegbar-api\", uri=~\"$uri\", method=~\"$method\"}[$__range]))",
          "instant": true,
          "range": false,
          "refId": "A",
          "format": "table"
